# Local .env for server/zapper_render — contains sensitive secrets. DO NOT commit this file.
# This file is intended for local testing. For production (Render), set the same
# variables in Render's Environment/Secrets and DO NOT commit secrets to Git.

# Firestore service account (base64-encoded JSON). This is the preferred local
# option because it avoids newline quoting issues in some shells.
FIRESTORE_SERVICE_ACCOUNT_

# Enable live mode (true to call Zapper, false to use local stub)
REAL_ZAPPER=true

# Zapper endpoints (use your real Zapper API in production)
ZAPPER_CREATE_URL=https://api.zapper.com/business/api/v1/merchants/{merchantId}/sites/{siteId}/invoices
ZAPPER_VERIFY_URL=https://api.zapper.com/business/api/v1/merchants/{merchantId}/invoices/{invoiceId}/payments

# Zapper account credentials
ZAPPER_MERCHANT_ID=74970
ZAPPER_SITE_ID=94625
ZAPPER_POS_KEY=5392ABC9-0490-4080-A285-B938D9DF94B8
ZAPPER_POS_SECRET=7AE7A548-1EF0-489A-8948-FE1BE01DE9DD
ZAPPER_POS_SIGNATURE_HEADER=x-pos-signature

# Additional merchant keys (if provided)
MERCHANT_API_KEY=41252056789647e5863392d7aba378d2
MERCHANT_SITE_API_KEY=3131ee0e18c7414fb94dae40779e823d

# Generic PSP fallback (optional)
PSP_API_KEY=41252056789647e5863392d7aba378d2
PSP_API_KEY_HEADER=Authorization
PSP_WEBHOOK_SECRET=

# Public BASE URL (for local testing you can set to your public tunnel URL)
BASE_URL=https://specconnect-2accc.web.app

# Server port for local testing
SERVER_PORT=3031

