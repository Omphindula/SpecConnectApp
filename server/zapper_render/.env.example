## Example environment variables for the Zapper backend
# Zapper API settings
ZAPPER_API_BASE=https://api.zapper.example
ZAPPER_CREATE_PATH=/v1/payments
ZAPPER_VERIFY_PATH=/v1/payments/{paymentId}
ZAPPER_API_KEY=your_zapper_api_key_here
ZAPPER_API_KEY_HEADER=Authorization

# Webhook secret used to validate incoming requests from Zapper (HMAC or vendor header)
ZAPPER_WEBHOOK_SECRET=your_webhook_secret_here
ZAPPER_WEBHOOK_SIGNATURE_HEADER=x-zapper-signature

# Firebase Admin service account (either JSON string or set FIRESTORE_SERVICE_ACCOUNT_FILE below)
# Option A: set full JSON here (escape newlines) - recommended to use secrets manager instead of env in production
FIRESTORE_SERVICE_ACCOUNT=
# Option B: path to a service account file in the deployment (less secure on Render)
FIRESTORE_SERVICE_ACCOUNT_FILE=

# Render / server
PORT=3000

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=https://your-app-domain.example,https://your-other-origin
